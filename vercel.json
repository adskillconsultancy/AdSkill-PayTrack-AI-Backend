{
  "version": 2,
  "builds": [
    {
      "src": "src/server.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "includeFiles": [
          "src/lib/pdfkit.standalone.js",
          "dist/lib/pdfkit.standalone.js",
          "node_modules/pdfkit/**"
        ]
      }
    }
  ],

  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/server.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/backups/run",
      "schedule": "0 4 * * *"
    }
  ]
}
