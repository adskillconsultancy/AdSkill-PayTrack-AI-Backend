// Prisma Schema for AdSkill PayTrack AI Backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== ENUMS ====================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ServiceCategory {
  IMMIGRATION
  BUSINESS
  CONSULTATION
  DMV_PSB
  CUSTOM
}

enum CaseStatus {
  INTAKE
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum FinancialStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum DocumentType {
  AGREEMENT
  INVOICE
  RECEIPT
  PAYMENT_PROOF
  IDENTITY
  SUPPORTING
  OTHER
}

enum DocumentScanStatus {
  PENDING
  CLEAN
  REJECTED
}

enum NoteVisibility {
  CLIENT
  STAFF
  SUPER_ADMIN
}

// ==================== MODELS ====================

// Dynamic User Role model - supports future role expansion
model UserRole {
  id              String           @id @default(uuid())
  name            String           @unique // e.g. SUPER_ADMIN, MANAGER, CONSULTANT, CLIENT
  isDeleted       Boolean          @default(false)
  deletedAt       DateTime?

  // Relations
  users           User[]
  rolePermissions RolePermission[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("user_roles")
}

// Granular System Permission model (PBAC Architecture)
model Permission {
  id              String           @id @default(uuid())
  name            String           @unique // e.g. 'user:read', 'user:create', 'payment:verify'
  module          String           // e.g. 'USER', 'SERVICE', 'PLAN', 'PAYMENT', 'INVOICE', 'REPORT', 'NOTE'
  description     String?
  isDeleted       Boolean          @default(false)
  deletedAt       DateTime?

  // Relations
  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("permissions")
}

// Role-Permission bridge table for dynamic privilege assignment
model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  isDeleted    Boolean    @default(false)
  deletedAt    DateTime?

  // Relations
  role         UserRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// User model - includes identity, contact, address, and client profile details
model User {
  id                   String     @id @default(uuid())
  clientId             String?    @unique // Unique business ID for clients (e.g. ASK-2026-0001)
  name                 String     // Legal full name
  preferredName        String?    // Preferred name
  email                String     @unique
  password             String
  phone                String?
  whatsapp             String?    // WhatsApp contact number
  address              String?    // Physical street address
  city                 String?
  state                String?
  postalCode           String?
  country              String?    // Country of origin / residence

  // Dynamic Role Relation
  roleId               String
  role                 UserRole         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  // Direct User Capabilities (IAM / PBAC Overrides)
  userPermissions      UserPermission[]

  status               UserStatus       @default(ACTIVE)
  isMfaEnabled         Boolean          @default(false)
  mfaSecret            String?

  // Universal Soft Delete Policy
  isDeleted            Boolean          @default(false)
  deletedAt            DateTime?

  // Service Audit Relations
  createdServices      Service[]        @relation("ServiceCreatedBy")
  updatedServices      Service[]        @relation("ServiceUpdatedBy")
  clientCases          ClientCase[]
  assignedCases        ClientCase[]     @relation("CaseConsultant")
  uploadedDocuments   Document[]       @relation("DocumentUploadedBy")
  documents            Document[]       @relation("DocumentOwner")
  verifiedPayments     Payment[]        @relation("PaymentVerifiedBy")
  auditLogs            AuditLog[]
  caseNotes            CaseNote[]       @relation("CaseNoteAuthor")

  // Support Ticket Relations
  clientSupportTickets    SupportTicket[]  @relation("ClientSupportTickets")
  consultantSupportTickets SupportTicket[] @relation("ConsultantSupportTickets")
  handledSupportTickets   SupportTicket[]  @relation("StaffHandledTickets")
  supportMessages         SupportMessage[] @relation("MessageSender")

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@map("users")
}

// User-Permission bridge table for direct user capability overrides
model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  permissionId String
  isRevoked    Boolean    @default(false) // false = GRANT (+), true = REVOKE / DENY (-)
  isDeleted    Boolean    @default(false)
  deletedAt    DateTime?

  // Relations
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

// Service Catalog model - represents advisory & legal offerings with strict fee separation
model Service {
  id                     String          @id @default(uuid())
  name                   String          @unique
  code                   String          @unique // e.g. EB2-NIW, EB1-A, CONSULT-1HR
  category               ServiceCategory @default(IMMIGRATION)
  description            String?
  baseFee                Decimal         @db.Decimal(12, 2) // AdSkill professional fee (revenue)
  estimatedGovFee        Decimal         @default(0.00) @db.Decimal(12, 2) // USCIS / government filing fees (pass-through)
  estimatedAttorneyFee   Decimal         @default(0.00) @db.Decimal(12, 2) // Outside legal counsel fees (pass-through)
  estimatedThirdPartyFee Decimal         @default(0.00) @db.Decimal(12, 2) // Evaluations, translations, business plans (pass-through)
  currency               String          @default("USD")
  defaultDeposit         Decimal?        @db.Decimal(12, 2) // Suggested upfront retainer deposit
  defaultInstallments    Int?            // Suggested milestone installment count
  estimatedDuration      String?         // Expected completion timeline (e.g. "6-9 months")
  isActive               Boolean         @default(true)

  // Actor Audit Traceability
  createdById            String
  createdBy              User            @relation("ServiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById            String?
  updatedBy              User?           @relation("ServiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  // Universal Soft Delete Policy
  isDeleted              Boolean         @default(false)
  deletedAt              DateTime?

  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  clientCases            ClientCase[]

  @@map("services")
}

model ClientCase {
  id                    String         @id @default(uuid())
  caseCode              String         @unique
  userId                String
  serviceId             String
  serviceCodeSnapshot   String
  serviceNameSnapshot   String
  serviceCategorySnapshot ServiceCategory
  destinationCountry    String?
  caseCategory          String?
  caseSubcategory       String?
  assignedConsultantId  String?
  agreementDate         DateTime?
  serviceStartDate      DateTime?
  caseStatus            CaseStatus     @default(INTAKE)
  financialStatus       FinancialStatus @default(UNPAID)
  clientVisibleNotes    String?
  internalNotes         String?
  superAdminNotes       String?
  isDeleted             Boolean        @default(false)
  deletedAt             DateTime?
  closedAt              DateTime?

  user                  User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  service               Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  assignedConsultant    User?          @relation("CaseConsultant", fields: [assignedConsultantId], references: [id], onDelete: SetNull)
  documents             Document[]
  paymentPlans          PaymentPlan[]
  payments              Payment[]
  invoices              Invoice[]
  receipts              Receipt[]
  caseNotes             CaseNote[]
  supportTickets        SupportTicket[]

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([userId, isDeleted, createdAt])
  @@index([serviceId])
  @@map("client_cases")
}

model CaseNote {
  id         String         @id @default(uuid())
  caseId     String
  authorId   String
  content    String         // Rich HTML formatted content
  visibility NoteVisibility @default(STAFF)
  isPinned   Boolean        @default(false)
  isDeleted  Boolean        @default(false)
  deletedAt  DateTime?

  case       ClientCase     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author     User           @relation("CaseNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([caseId, visibility, isDeleted])
  @@index([authorId, isDeleted])
  @@map("case_notes")
}


model PaymentPlan {
  id                    String   @id @default(uuid())
  caseId                String
  currency              String
  baseFeeSnapshot       Decimal  @db.Decimal(12, 2)
  discountAmount        Decimal  @default(0.00) @db.Decimal(12, 2)
  discountReason        String?
  contractedFee         Decimal  @db.Decimal(12, 2)
  depositAmount         Decimal  @default(0.00) @db.Decimal(12, 2)
  scheduleType          String
  paymentMethod         String?
  gracePeriodDays       Int      @default(0)
  latePaymentPolicy     String?
  isActive              Boolean  @default(true)
  isDeleted             Boolean  @default(false)
  deletedAt             DateTime?

  case                  ClientCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  installments          Installment[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([caseId, isDeleted])
  @@map("payment_plans")
}

model Installment {
  id              String   @id @default(uuid())
  paymentPlanId   String
  sequenceNumber  Int
  title           String?
  amount          Decimal  @db.Decimal(12, 2)
  dueDate         DateTime
  status          String   @default("PENDING")
  isDeleted       Boolean  @default(false)
  deletedAt       DateTime?

  paymentPlan     PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Restrict)
  payments        Payment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([paymentPlanId, sequenceNumber])
  @@map("installments")
}

model Payment {
  id                    String   @id @default(uuid())
  caseId                String
  installmentId         String?
  amount                Decimal  @db.Decimal(12, 2)
  currency              String
  paymentDate           DateTime
  recordedAt            DateTime @default(now())
  paymentMethod         String
  externalReference     String?
  stripePaymentIntentId String?
  idempotencyKey        String?
  status                String   @default("PENDING")
  verifiedById          String?
  operationalNotes      String?
  isDeleted             Boolean  @default(false)
  deletedAt             DateTime?

  case                  ClientCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  installment           Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  verifiedBy            User?      @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  proofDocuments        Document[]
  receipts              Receipt[] @relation("PaymentReceipts")

  @@unique([idempotencyKey])
  @@index([caseId, isDeleted, paymentDate])
  @@map("payments")
}

model Document {
  id             String             @id @default(uuid())
  userId         String
  caseId         String
  paymentId      String?
  documentType   DocumentType       @default(SUPPORTING)
  objectKey      String             @unique
  bucket         String
  storedName     String
  originalName   String
  mimeType       String
  size           Int
  uploadedById   String
  scanStatus     DocumentScanStatus @default(PENDING)
  isDeleted      Boolean            @default(false)
  deletedAt      DateTime?

  owner          User       @relation("DocumentOwner", fields: [userId], references: [id], onDelete: Restrict)
  case           ClientCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  uploadedBy     User       @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  payment        Payment?   @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, caseId, isDeleted])
  @@map("documents")
}

model Invoice {
  id              String   @id @default(uuid())
  caseId          String
  invoiceNumber   String   @unique
  currency        String
  amount          Decimal  @db.Decimal(12, 2)
  status          String   @default("ISSUED")
  issuedAt        DateTime @default(now())
  isDeleted       Boolean  @default(false)
  deletedAt       DateTime?

  case            ClientCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  receipts        Receipt[]

  @@index([caseId, isDeleted])
  @@map("invoices")
}

model Receipt {
  id              String   @id @default(uuid())
  caseId          String
  invoiceId       String?
  paymentId       String?
  receiptNumber   String   @unique
  currency        String
  amount          Decimal  @db.Decimal(12, 2)
  issuedAt        DateTime @default(now())
  isDeleted       Boolean  @default(false)
  deletedAt       DateTime?

  case            ClientCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  invoice         Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment         Payment?   @relation("PaymentReceipts", fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([caseId, isDeleted])
  @@map("receipts")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  actorEmail    String?
  action       String
  targetEntity String
  targetId     String
  beforeValue  Json?
  afterValue   Json?
  reason       String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetEntity, targetId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ==================== SUPPORT & MESSAGING ====================

enum SupportTargetType {
  CONSULTANT
  MANAGEMENT_ADMIN
}

enum SupportCategory {
  CASE_STATUS
  DOCUMENT_VERIFICATION
  BILLING_PAYMENT
  MILESTONE_SCHEDULE
  SERVICE_INQUIRY
  GENERAL
}

enum SupportPriority {
  LOW
  NORMAL
  URGENT
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CLIENT
  RESOLVED
  CLOSED
}

model SupportTicket {
  id                    String            @id @default(uuid())
  ticketCode            String            @unique // e.g. TKT-2026-1042
  clientId              String
  caseId                String?
  targetType            SupportTargetType @default(MANAGEMENT_ADMIN)
  assignedConsultantId  String?           // Auto-populated if target is CONSULTANT
  assignedStaffId       String?           // Staff/Admin actively handling or replying
  category              SupportCategory   @default(GENERAL)
  priority              SupportPriority   @default(NORMAL)
  status                SupportStatus     @default(OPEN)
  subject               String
  lastMessageAt         DateTime          @default(now())
  isDeleted             Boolean           @default(false)
  deletedAt             DateTime?

  client                User              @relation("ClientSupportTickets", fields: [clientId], references: [id], onDelete: Restrict)
  case                  ClientCase?       @relation(fields: [caseId], references: [id], onDelete: SetNull)
  assignedConsultant    User?             @relation("ConsultantSupportTickets", fields: [assignedConsultantId], references: [id], onDelete: SetNull)
  assignedStaff         User?             @relation("StaffHandledTickets", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  messages              SupportMessage[]

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([clientId, isDeleted])
  @@index([targetType, status, isDeleted])
  @@index([assignedConsultantId, isDeleted])
  @@index([assignedStaffId, isDeleted])
  @@map("support_tickets")
}

model SupportMessage {
  id           String        @id @default(uuid())
  ticketId     String
  senderId     String
  message      String        @db.Text
  isStaffReply Boolean       @default(false)
  attachments  Json?         // Array of attachment URLs / metadata
  readAt       DateTime?

  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender       User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([ticketId, createdAt])
  @@map("support_messages")
}


