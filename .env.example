NODE_ENV=development
PORT=5000

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:password@localhost:5432/adskill_paytrack_dev?schema=public"

# JWT Secrets
JWT_ACCESS_SECRET="your_super_secret_jwt_access_key_change_in_production"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="your_super_secret_jwt_refresh_key_change_in_production"
JWT_REFRESH_EXPIRES_IN="30d"

# Bcrypt Salt Rounds
BCRYPT_SALT_ROUNDS=12

# Frontend URL for CORS
CLIENT_URL="http://localhost:5173"

# Cloudflare R2 private object storage
R2_ENDPOINT="https://<account-id>.<jurisdiction>.r2.cloudflarestorage.com"
R2_BUCKET_NAME="paytrackai"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_SIGNED_URL_EXPIRES_IN=300
R2_MAX_FILE_SIZE_MB=10
# Optional only if you later add a custom public/domain CDN; private buckets can leave this empty
R2_PUBLIC_BASE_URL=""

# Stripe Payment Gateway (Test Mode credentials — get from dashboard.stripe.com)
# STRIPE_SECRET_KEY: NEVER expose this to the frontend or commit to git
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
# STRIPE_PUBLISHABLE_KEY: Safe for frontend (NEXT_PUBLIC_ prefix), but also stored here for reference
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key_here"
# STRIPE_WEBHOOK_SECRET: Generated by Stripe CLI (local dev) or Stripe Dashboard (production)
# Run: stripe listen --forward-to localhost:5000/api/v1/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_signing_secret_here"
